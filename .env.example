# All optional. With nothing set, the app uses PeerJS's free public broker
# (0.peerjs.com) for the join handshake only; audio and files stay peer to peer.

# Self-hosted PeerJS server (https://github.com/peers/peerjs-server)
# NEXT_PUBLIC_PEER_HOST=peer.example.com
# NEXT_PUBLIC_PEER_PORT=443
# NEXT_PUBLIC_PEER_PATH=/
# NEXT_PUBLIC_PEER_SECURE=true
# NEXT_PUBLIC_PEER_KEY=peerjs

# TURN relay for phones on different networks (cellular vs Wi-Fi)
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=user
# NEXT_PUBLIC_TURN_CREDENTIAL=secret
